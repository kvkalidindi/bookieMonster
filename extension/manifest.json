{
  "manifest_version": 3,
  "name": "bookieMonster",
  "short_name": "bookieMonster",
  "version": "1.0.0",
  "description": "Backs up all your X bookmarks with folder assignments, keeps the archive current, and saves LLM-ready files.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "bookieMonster",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "dashboard.html",
  "permissions": [
    "alarms",
    "cookies",
    "declarativeNetRequestWithHostAccess",
    "downloads",
    "offscreen",
    "unlimitedStorage",
    "webRequest"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://abs.twimg.com/*"
  ]
}
